{
  "name": "@ssi-pq/react-native",
  "version": "0.1.0",
  "description": "React Native bindings for SSI-PQ credentials, wallets and post-quantum PDF signing.",
  "license": "MIT OR Apache-2.0",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "react-native": "src/index.ts",
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./node-compatible": {
      "react-native": "./src/node-compatible.ts",
      "types": "./src/node-compatible.ts",
      "default": "./src/node-compatible.ts"
    }
  },
  "files": [
    "android",
    "example",
    "ios",
    "src",
    "react-native.config.js",
    "README.md"
  ],
  "scripts": {
    "build:android": "../../scripts/build-mobile-android.sh",
    "build:ios": "../../scripts/build-mobile-ios.sh",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node --test lib-test/test/*.test.js"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": ">=0.86.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0"
  },
  "codegenConfig": {
    "name": "SsiPqSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.ssipq.reactnative"
    }
  }
}
