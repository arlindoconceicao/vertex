DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/vertex_db"
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

RESEND_API_KEY=""
RESEND_FROM_EMAIL="onboarding@resend.dev"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- SEGURANÇA M2M (MOBILE APP) ---
# Tokens HMAC usados para autenticar a comunicação entre o App Mobile e a Plataforma.
# Se AMBAS as variáveis estiverem habilitadas (descomentadas), o sistema usará
# EXCLUSIVAMENTE a variável SIGNER_SECRETS e ignorará a SIGNER_SECRET.
#
# A primeira senha da lista em SIGNER_SECRETS será usada para gerar os novos tokens,
# enquanto as demais servirão apenas para validação de apps antigos (Grace Period Rotation).
# Gerar cada senha com: openssl rand -base64 32

# (Opção 1) Rotação de múltiplas senhas habilitada:
# SIGNER_SECRETS="nova_senha_super_segura_v2,senha_antiga_v1"

# (Opção 2) Apenas uma senha simples (Fallback):
SIGNER_SECRET=""

# --- CRON JOBS ---
# Segredo utilizado para proteger endpoints de cron (ex: limpeza de PDFs expirados)
# O sistema que dispara o cron deve enviar este segredo no cabeçalho: Authorization: Bearer <CRON_SECRET>
# Gerar com: openssl rand -base64 32
CRON_SECRET=""